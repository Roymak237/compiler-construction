# Python bytecode
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# LaTeX intermediates. report.tex is generated by `python -m yca report`
# and report.pdf is the deliverable, so both of those stay tracked; these
# are pure build noise that changes on every single run.
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# Beamer writes two more navigation files per run, on the same footing as
# the .aux and .toc above.
*.nav
*.snm
*.vrb

# Scratch: throwaway diagnostic scripts and captured command output. These
# are written while investigating something and are never part of the work.
scratch_*.py
gen.txt
t.txt
build/

# Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Deployment secrets. The DuckDNS token can repoint the domain at anyone's
# server, so it must never reach the repository.
duckdns.env
*.pem
*.key
