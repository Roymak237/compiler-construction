# Git would otherwise hand these back with CRLF line endings on Windows,
# and bash on the server fails with the famously unhelpful
#     $'\r': command not found
# Forcing LF means a clone on Windows still produces files the VPS can run.
*.sh            text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.conf          text eol=lf

# Normal text files: normalise to LF in the repository, native in the
# working copy.
*.py            text
*.tex           text
*.md            text
*.html          text
*.css           text
*.js            text
*.json          text

# Binary: never touch these.
*.png           binary
*.jpg           binary
*.pdf           binary
